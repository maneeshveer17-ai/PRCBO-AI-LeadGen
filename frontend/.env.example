# ==============================================================================
# PRCBO AI LeadGen: Frontend Environment Variables
# Copy this file to .env.local or .env in the frontend directory:
#   cp .env.example .env
#
# NEVER commit actual secrets or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (REQUIRED for Persistent Lead Storage)
# Obtain these from your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public / Anonymous Client Key (Safe for frontend browsers)
# IMPORTANT: NEVER use or expose the service_role secret key in Vite/frontend code.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Google Maps JavaScript API (Optional)
# Leave placeholder or blank to use the built-in OpenStreetMap raster engine.
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
